// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  emailVerified DateTime?
  image     String?
  username  String?
  name      String?
  googleId  String?  @unique
  accessToken String?
  refreshToken String?
  expiresAt   DateTime?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
